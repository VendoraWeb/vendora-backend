# Salin file ini menjadi .env untuk pengembangan lokal (JANGAN commit .env ke Git!)

# MongoDB Configuration
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/vendora_db?retryWrites=true&w=majority
DB_NAME=vendora_db

# Server Port (lokal)
PORT=8081

# Opsional: tambahan origin frontend yang diizinkan CORS (pisahkan koma)
# CORS_ORIGINS=https://staging.vendorashop.my.id

# Pengirim OTP Email — pilih salah satu (Resend atau SMTP mis. Gmail App Password)
# RESEND_API_KEY=re_xxxxxxxxx
# OTP_EMAIL_FROM=Vendora <noreply@vendorashop.my.id>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=email-pengirim@gmail.com
SMTP_PASS=app-password-16-karakter
SMTP_FROM=email-pengirim@gmail.com

# Pengirim OTP WhatsApp/SMS — pilih salah satu (Fonnte atau Twilio)
FONNTE_TOKEN=token-fonnte-anda
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Kunci HMAC rahasia untuk hash kode OTP & reset token (isi string acak 64 hex)
OTP_SECRET=ganti-dengan-string-acak-panjang

# Hanya untuk pengembangan lokal jika belum mengatur provider OTP (JANGAN true di production!)
# OTP_DEV_LOG=true
